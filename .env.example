# A starting set. The README Configuration section lists every variable.

# Authentication method: cli, api_key, bedrock or vertex.
# Unset: detected from the env vars present (for example ANTHROPIC_API_KEY).
# CLAUDE_AUTH_METHOD=cli

# Key that clients must send to the wrapper.
# Unset: the server asks at startup whether to generate one.
# API_KEY=your-optional-api-key-here

# Server Configuration
PORT=8000
# Bind address: 127.0.0.1 for local only, 0.0.0.0 for all interfaces.
# CLAUDE_WRAPPER_HOST=0.0.0.0
# Maximum request body size in bytes (default: 10MB)
# MAX_REQUEST_SIZE=10485760

# Timeout Configuration (milliseconds)
MAX_TIMEOUT=600000

# CORS Configuration
CORS_ORIGINS=["*"]

# Model Configuration
# Model used when a request names none. Unset: the latest Sonnet from
# Anthropic's live Models API when ANTHROPIC_API_KEY is set, otherwise
# claude-sonnet-5-5.
# DEFAULT_MODEL=claude-sonnet-5-5

# Speed/cost-optimized model alias.
# FAST_MODEL=claude-haiku-5-5

# Model Discovery (optional)
# With ANTHROPIC_API_KEY set, /v1/models returns Anthropic's live model list
# (cached for 1 hour) and DEFAULT_MODEL resolves to the latest Sonnet at
# startup. Bedrock, Vertex and Claude CLI auth work without it; /v1/models
# then returns the static list.
# ANTHROPIC_API_KEY=sk-ant-...

# Subscription OAuth token, read by the bundled Claude CLI. Use it instead
# of ANTHROPIC_API_KEY when you authenticate with `claude auth`.
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Pin the advertised model list. Overrides the live and static lists.
# CLAUDE_MODELS_OVERRIDE=claude-sonnet-5-5,claude-opus-5-5

# Cache TTL for live /v1/models results (seconds).
# MODEL_LIST_CACHE_TTL_SECONDS=3600

# Cache TTL after a failed live fetch (seconds).
# MODEL_LIST_ERROR_TTL_SECONDS=60

# HTTP timeout for the live model fetch (seconds).
# MODEL_LIST_REQUEST_TIMEOUT_SECONDS=5

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_MINUTE=120
RATE_LIMIT_DEBUG_PER_MINUTE=2
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_SESSION_PER_MINUTE=15
RATE_LIMIT_HEALTH_PER_MINUTE=30

# Quota Tracking
# Refuse requests with 429 while a quota window is rejected. Off by default
# because refusing changes behaviour for existing callers.
# WRAPPER_QUOTA_ENFORCEMENT_ENABLED=false

# Requests between quota refresh probes. A probe is a real 1-turn call that
# spends quota. Set 0 to rely on live traffic alone.
# WRAPPER_QUOTA_PROBE_EVERY_N_REQUESTS=100

# Minimum seconds between quota probes.
# WRAPPER_QUOTA_PROBE_MIN_INTERVAL_SECONDS=300

# Age in seconds at which a /v1/usage reading is reported as stale.
# WRAPPER_QUOTA_STALE_AFTER_SECONDS=900

# Circuit Breaker
# Enable the upstream SDK failure circuit breaker.
# WRAPPER_CIRCUIT_BREAKER_ENABLED=true

# Failure-rate measurement window (seconds).
# WRAPPER_CIRCUIT_BREAKER_WINDOW_SECONDS=60

# Failure ratio within the window that opens the breaker.
# WRAPPER_CIRCUIT_BREAKER_THRESHOLD=0.75

# Minimum requests in the window before the breaker can open.
# WRAPPER_CIRCUIT_BREAKER_MIN_REQUESTS=20

# Seconds before the breaker allows one probe request.
# WRAPPER_CIRCUIT_BREAKER_OPEN_SECONDS=30
